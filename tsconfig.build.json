{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false, // Writes js files only for not test scripts from src/*
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Other Outputs
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
